{
  "name": "z-team-fulfulde",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Fulfulde accessibility layer for digital financial services.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @zteam/extension dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint apps packages scripts e2e",
    "lint:fix": "oxlint --fix apps packages scripts e2e",
    "package": "node scripts/package-extension.mjs",
    "size:check": "node scripts/size-check.mjs",
    "e2e": "playwright test",
    "setup:e2e": "pnpm exec playwright install chromium",
    "strings": "tsx scripts/extract-strings.ts",
    "coverage": "tsx scripts/coverage.ts",
    "prewarm": "uv run --project apps/server python scripts/prewarm.py",
    "demo": "node scripts/demo.mjs",
    "demo:check": "node scripts/demo.mjs --check",
    "demo:stub": "node scripts/demo.mjs --stub",
    "hooks": "git config core.hooksPath .githooks",
    "audit": "pnpm audit --audit-level high",
    "ai:check": "node scripts/check-ai-config.mjs",
    "verify": "bash scripts/verify-submission.sh",
    "verify:node": "pnpm ci:local && pnpm e2e && pnpm audit --audit-level high",
    "ci:local": "pnpm ai:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm package && pnpm size:check && uv run --project apps/server ruff check apps/server && uv run --project apps/server ruff format --check apps/server && uv run --project apps/server mypy apps/server/app --config-file apps/server/pyproject.toml && uv run --project apps/server pytest",
    "build:test": "node scripts/build-test-extension.mjs",
    "serve:eval": "node scripts/serve-eval.mjs",
    "serve:listening": "node scripts/serve-eval.mjs --root eval/linguistic/session --port 4175",
    "check:live": "node scripts/check-live.mjs",
    "check:sites": "node scripts/check-sites.mjs",
    "models:download": "node scripts/download-models.mjs",
    "models:verify": "node scripts/download-models.mjs --check",
    "doctor": "node scripts/doctor.mjs",
    "bootstrap": "node scripts/setup.mjs",
    "generate:listening": "node scripts/generate-listening-pack.mjs",
    "note:build": "node scripts/build-note.mjs",
    "submission": "node scripts/assemble-submission.mjs",
    "probe:models": "uv run --project apps/server python scripts/probe-models.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@zteam/translator": "workspace:*",
    "fflate": "^0.8.3",
    "oxlint": "latest",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "yaml": "^2.5.0"
  }
}
