{
  "name": "@zteam/phrasebank",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "entries",
    "numbers"
  ],
  "scripts": {
    "build": "tsx src/build.ts && tsc -p tsconfig.build.json",
    "build:release": "tsx src/build.ts --release && tsc -p tsconfig.build.json",
    "check:evidence": "tsx src/check-evidence.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:fixture": "tsx src/build.ts --fixture"
  },
  "dependencies": {
    "@zteam/shared": "workspace:*",
    "yaml": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
