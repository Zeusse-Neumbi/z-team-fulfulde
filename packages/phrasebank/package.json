{
  "name": "@zteam/phrasebank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["dist", "entries", "numbers"],
  "scripts": {
    "build": "tsx src/build.ts && tsc -p tsconfig.build.json",
    "build:release": "tsx src/build.ts --release && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zteam/shared": "workspace:*",
    "yaml": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
