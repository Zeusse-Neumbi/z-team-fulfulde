#!/bin/sh

set -eu

message_file=$1
subject=$(head -n 1 "$message_file")

case "$subject" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*)
        exit 0
        ;;
esac

pattern='^(feat|fix|docs|chore|refactor|test|perf|build|ci|style|revert)(\([a-z0-9._-]+\))?!?: .+'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
    printf 'Commit blocked: use a Conventional Commit subject, for example "feat(translator): keep protected values".\n' >&2
    printf 'Got: %s\n' "$subject" >&2
    exit 1
fi
