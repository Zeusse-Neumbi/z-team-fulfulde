# Development environment.
#
# The shipped extension and local API never read these keys and never call a
# cloud provider at runtime. The keys below are for local development tooling:
# GitHub CLI/MCP, Hugging Face model downloads and the Context7 docs MCP.
#
# Copy this file to `.env` and fill only what you need:
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real keys, real page values or personal data.

# ---------------------------------------------------------------------------
# Local API (runtime, loopback only)
# ---------------------------------------------------------------------------
ZTEAM_HOST=127.0.0.1
ZTEAM_PORT=8000
ZTEAM_LOG_LEVEL=info

# Cloud providers are refused unless this is explicitly enabled. They exist
# for a measurement run only and send text off the device. See docs/MODELS.md.
ZTEAM_ALLOW_CLOUD=0
ZTEAM_CLOUD_TIMEOUT_S=20

# Translation backends: stub | ollama | nllb | marian | google
# --- Languages -------------------------------------------------------------
# Target language registry. One languages/<code>.yaml row per language; adding
# a language is data, not code. The default pack follows this code.
ZTEAM_TARGET_LANG=fub
ZTEAM_LANGUAGES_DIR=languages

#
# Default Fulfulde stack: NLLB-200 int8. It is the only local model that kept
# every amount, phone number and reference byte-identical in the 20-sentence
# head-to-head (6/6 vs 0/6) and never repeated itself. See docs/MODELS.md and
# ADR 0019. NLLB has no `fub` token; it uses `fuv_Latn` (Nigerian Fulfulde), so
# the text is a labelled proxy, not Adamawa validation.
#
# The Cameroonian pair is opt-in only:
#   ZTEAM_MT_BACKEND=marian   # + the line below
# It has the right AGLC alphabet but failed the same head-to-head (0/6 values),
# so it is not the default.
#
ZTEAM_MT_BACKEND=nllb
# Explicit overrides. Empty resolves from languages/<code>.yaml for the target.
ZTEAM_MT_MARIAN_MODEL=
# Optional M2M100 Yemba FR->ybb fine-tune (MIT); larger/slower, opt-in.
ZTEAM_MT_M2M100_MODEL=models/m2m100-yemba-fr2ybb
ZTEAM_MT_MODEL=models/nllb-200-600m-int8
ZTEAM_MT_TOKENIZER=models/nllb-200-600m-tokenizer
ZTEAM_MT_RUNTIME=ct2
ZTEAM_MT_DEVICE=cpu
ZTEAM_MT_COMPUTE_TYPE=int8
ZTEAM_MT_BEAM_SIZE=2
ZTEAM_MT_MAX_INPUT_CHARS=1000
ZTEAM_MT_SOURCE_LANGS=fr,en
ZTEAM_MT_TARGET_LANG=fuv_Latn

# Local Ollama provider (loopback only; no key).
ZTEAM_OLLAMA_BASE_URL=http://127.0.0.1:11434
ZTEAM_OLLAMA_MODEL=gemma4:12b-it-qat
ZTEAM_OLLAMA_TIMEOUT_S=90
ZTEAM_OLLAMA_NUM_PREDICT=256
ZTEAM_OLLAMA_TEMPERATURE=0.0

# Google Cloud Translation v2 (test only).
# Create a key: https://console.cloud.google.com/apis/credentials
# Enable the "Cloud Translation API" on the project first.
ZTEAM_GOOGLE_TRANSLATE_API_KEY=
ZTEAM_GOOGLE_TRANSLATE_TARGET=ff

# Speech backends: stub | mms | camb | elevenlabs
ZTEAM_TTS_BACKEND=stub
# Explicit override. Empty resolves from languages/<code>.yaml for the target.
ZTEAM_TTS_MODEL=
ZTEAM_TTS_DEVICE=cpu
ZTEAM_TTS_MAX_CHARS=500
ZTEAM_TTS_CACHE_SIZE=32
ZTEAM_ASR_BACKEND=stub

# Camb.ai MARS 8.1 (test only; explicit Adamawa locale fub-cm).
# Create a key: https://www.camb.ai/ dashboard -> API keys.
# Get a voice id from GET https://client.camb.ai/apis/list-voices
ZTEAM_CAMB_API_KEY=
ZTEAM_CAMB_VOICE_ID=
ZTEAM_CAMB_LANGUAGE=fub-cm
ZTEAM_CAMB_MODEL=mars-8.1-flash-beta
ZTEAM_CAMB_BASE_URL=https://client.camb.ai/apis
ZTEAM_CAMB_TIMEOUT_S=60

# ElevenLabs (test only; locale ff is Fula/Pulaar, not Adamawa).
# Create a key: https://elevenlabs.io/app/settings/api-keys
ZTEAM_ELEVENLABS_API_KEY=
ZTEAM_ELEVENLABS_VOICE_ID=
ZTEAM_ELEVENLABS_MODEL=eleven_v4
ZTEAM_ELEVENLABS_LANGUAGE=ff
ZTEAM_ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ZTEAM_ELEVENLABS_TIMEOUT_S=60

# Phrasebank (read by the API and the release gate).
# Empty means derive from ZTEAM_TARGET_LANG + languages/<code>.yaml.
ZTEAM_PHRASEBANK_DIR=
ZTEAM_PHRASEBANK_NUMBERS=

# ---------------------------------------------------------------------------
# Development tooling only (never read by the shipped app)
# ---------------------------------------------------------------------------

# Helps on dual-stack networks with flaky IPv6 DNS (Node, npm, npx and some MCP
# clients). Export it before starting OpenCode if a remote MCP times out.
NODE_OPTIONS=--dns-result-order=ipv4first

# GitHub CLI and the optional GitHub MCP server.
# Create a fine-grained PAT: https://github.com/settings/tokens
# Scopes: repo, issues, pull_requests, actions, projects (read/write as needed).
# `GH_TOKEN` is used by `gh`; `GITHUB_PERSONAL_ACCESS_TOKEN` by the GitHub MCP.
# They can be the same token. GitHub Actions supplies GITHUB_TOKEN automatically;
# do not set it in this file.
GITHUB_PERSONAL_ACCESS_TOKEN=
GH_TOKEN=
GITHUB_REPOSITORY=Zeusse-Neumbi/z-team-fulfulde
PROJECT_NUMBER=4

# Hugging Face model and dataset access.
# Create a token: https://huggingface.co/settings/tokens
# Used by `hf`, `transformers` and gated dataset downloads during development.
# The runtime never calls the Hugging Face Hub.
HF_TOKEN=
# Legacy alias for tools that still read the old variable name.
# HUGGING_FACE_HUB_TOKEN=
# Optional local cache for downloaded models and datasets.
HF_HOME=.cache/huggingface

# Context7 documentation MCP (optional; raises rate limits).
# Create a key: https://context7.com/dashboard
CONTEXT7_API_KEY=

# Optional GPU selection for the speech extra.
# CUDA_VISIBLE_DEVICES=0
